<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Contract of the Maia frontend manager: service org.maia.FrontendManager, object /FrontendManager.

  The C++ code of both sides is generated from this file: the adaptor of FrontendManagerService
  (server) and the proxy used by MFrontendModel (any process: the shell, MProxyWindow windows, apps).
  Change the contract here, not in the C++ headers.

  A frontend is described by a map (a{sv}) with the keys:
    id           sha1 of the frontend directory name
    name         display name (the directory name)
    description  description (for now the directory name)
    path         the shell entry point: <rootPath>/shell/Main.qml
    rootPath     the frontend directory, root of its QML module: apps look for their face
                 in <rootPath>/apps/<app>/Face.qml
    active       whether it is the active frontend
-->
<node>
  <interface name="org.maia.FrontendManager">
    <!-- All installed frontends -->
    <method name="getFrontendList">
      <arg name="frontends" type="aa{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;QVariantMap&gt;"/>
    </method>
    <!-- Id of the active frontend (empty when there is none) -->
    <method name="activeFrontend">
      <arg name="frontendId" type="s" direction="out"/>
    </method>
    <!-- Requests a switch; activeFrontendChanged follows once the new frontend is loaded -->
    <method name="setActiveFrontend">
      <arg name="frontendId" type="s" direction="in"/>
    </method>

    <signal name="activeFrontendChanged">
      <arg name="frontendId" type="s"/>
    </signal>
    <signal name="frontendAdded">
      <arg name="frontend" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </signal>
    <signal name="frontendRemoved">
      <arg name="frontendId" type="s"/>
    </signal>
  </interface>
</node>
