#!/bin/bash

# Defined version injected by CMake
VERSION="@PROJECT_VERSION@"
MAIA_DIR_NAME="Maia_${VERSION}"
MAIA_OPT_PATH="/opt/Maia/${MAIA_DIR_NAME}"

echo "Starting package lists update..."
# Attempt to run apt update. If it fails (e.g., no internet connection), the script will enter the 'if' block
if ! sudo apt update; then
    echo "=========================================================================="
    echo "CRITICAL ERROR: Failed to update package lists (apt update)."
    echo "Check your internet connection or network settings!"
    echo "=========================================================================="
    exit 1
fi

# Install kwin_wayland (compositor) and Xwayland (compatibility with X11-only applications)
# kwin (-y option automatically confirms the installation)
sudo apt install -y --no-install-recommends --no-install-suggests kwin-wayland
sudo apt install -y --no-install-recommends --no-install-suggests xwayland
# Qt Wayland platform plugin with shell integrations (xdg-shell). Required by Maia itself
# (it runs as a native Wayland client) and by Qt applications started in the session
# (QT_QPA_PLATFORM="wayland;xcb"), which would otherwise fall back to Xwayland.
sudo apt install -y --no-install-recommends --no-install-suggests qt6-wayland
# kwin aurorae engine libraries
sudo apt install -y --no-install-recommends --no-install-suggests kwin-common
# kwin aurorae qml-s data files
sudo apt install -y --no-install-recommends --no-install-suggests kwin-data
# Aurorae (SVG window decorations, engine v2; the decorations of the frontends, e.g. XPLuna's XBoomer)
sudo apt install -y --no-install-recommends --no-install-suggests kwin-style-aurorae
# Oxygen window decoration (the Maia frontend's default)
sudo apt install -y --no-install-recommends --no-install-suggests kwin-decoration-oxygen
# kwriteconfig6: how the appearance service writes kwinrc
sudo apt install -y --no-install-recommends --no-install-suggests libkf6config-bin
sudo apt install -y --no-install-recommends --no-install-suggests kwin-addons
# The "Maia (Wayfire)" session: the Wayfire compositor, and wpctl for the volume keys of its
# wayfire.ini (WirePlumber)
sudo apt install -y --no-install-recommends --no-install-suggests wayfire
sudo apt install -y --no-install-recommends --no-install-suggests wireplumber

# Ubuntu 24.10
# additional dependencies for kwin
# sudo apt install -y libkf5globalaccel-bin breeze libkf5kcmutils5

# Ubuntu 26.04
sudo apt install -y kglobalacceld breeze libkf6kcmutils-bin
# Qt platform theme plugin for KDE sessions. With KDE_FULL_SESSION and KDE_SESSION_VERSION set
# (run_maia_kwin.sh, run_maia_wayfire.sh) Qt selects the KDE theme, and without this plugin kwin_wayland crashes
# at startup on Ubuntu (Kubuntu has it preinstalled)
sudo apt install -y --no-install-recommends --no-install-suggests plasma-integration




# INSTALL MAIA
sudo apt install -y libqt6scxml6
sudo apt install -y libqt6webenginequick6
sudo apt install -y libqt6websockets6
sudo apt install -y qml6-module-qtquick-controls
sudo apt install -y qml6-module-qtcore
sudo apt install -y qml6-module-qtquick-effects
sudo apt install -y libqt6svg6
# Qt SVG image format and icon engine plugins (without them QML Image cannot load .svg files)
sudo apt install -y qt6-svg-plugins
sudo apt install -y qml6-module-qtquick-shapes
# Wayland layer-shell QML module (org.kde.layershell): window layers and anchoring to screen edges
sudo apt install -y --no-install-recommends --no-install-suggests qml6-module-org-kde-layershell
# Sound of the kitchen timer in the Lumen frontend (QtMultimedia QML module and the alarm sound)
sudo apt install -y qml6-module-qtmultimedia sound-theme-freedesktop

sudo apt install -y libkf6pulseaudioqt5



# Remove existing Maia directory if it exists (-f prevents prompts for read-only files)
sudo rm -v -rf "${MAIA_OPT_PATH}"

# Create /opt/Maia dir
sudo mkdir -p "/opt/Maia"

# Copy "Maia_version to /opt/Maia/Maia_version
sudo cp -v -r "$(dirname "$0")/${MAIA_DIR_NAME}" "${MAIA_OPT_PATH}"

# Set executable permissions for specific scripts
sudo chmod +x "${MAIA_OPT_PATH}/bin/run_maia_kwin.sh"
sudo chmod +x "${MAIA_OPT_PATH}/bin/run_maia_wayfire.sh"
sudo chmod +x "${MAIA_OPT_PATH}/bin/run_logger.sh"
sudo chmod +x "${MAIA_OPT_PATH}/bin/run_maia_nested_wayland.sh"


# Set read, write, and execute permissions for all users on the Maia directory and its contents
# The -R parameter (recursive) and 777 (full permissions) allow any user to modify/delete files (development needs)
sudo chmod -R 777 "/opt/Maia"


# REMOVE OBSOLETE X11 SESSION FILES (Maia supports only the Wayland session now)
sudo rm -v -f "/usr/share/xsessions/maia_${VERSION}-desktop.desktop"
sudo rm -v -f "/usr/share/xsessions/maia_${VERSION}-xsession.desktop"

# THE SESSIONS OF SDDM: "Maia <version> (KWin)" and "Maia <version> (Wayfire)"
sudo mkdir -p "/usr/share/wayland-sessions"
# The session of earlier builds ("Maia <version> (Wayland)", run_maia_wayland.sh) is the KWin one now
sudo rm -v -f "/usr/share/wayland-sessions/maia_${VERSION}-wayland.desktop"
for SESSION in kwin wayfire; do
    sudo cp -v "$(dirname "$0")/${MAIA_DIR_NAME}/bin/maia_${VERSION}-${SESSION}.desktop" "/usr/share/wayland-sessions/"
    sudo chmod 777 "/usr/share/wayland-sessions/maia_${VERSION}-${SESSION}.desktop"
done

# The Wayfire session needs two Wayfire plugins that are not part of Maia (yet): they are built and
# installed from their own projects (wayfire-aurorae, wayfire-plasma-window-management)
WAYFIRE_PLUGIN_DIR="$(pkg-config --variable=plugindir wayfire 2>/dev/null || echo /usr/lib/x86_64-linux-gnu/wayfire)"
for PLUGIN in aurorae plasma-window-management; do
    if [ ! -e "${WAYFIRE_PLUGIN_DIR}/lib${PLUGIN}.so" ]; then
        echo "WARNING: the Wayfire plugin ${PLUGIN} is not installed (${WAYFIRE_PLUGIN_DIR}/lib${PLUGIN}.so):"
        echo "         the Maia (Wayfire) session will lack it"
    fi
done


## Check for available updates (equivalent to apt update)
#sudo dnf check-update
## Install KWin packages without weak dependencies
#sudo dnf install -y --setopt=install_weak_deps=False kwin-wayland
#sudo dnf install -y --setopt=install_weak_deps=False kwin-common
## sudo dnf install -y --setopt=install_weak_deps=False kwin-data - unavailable
## sudo dnf install -y --setopt=install_weak_deps=False kwin-addons - unavailable
