#!/bin/bash
# Sesja "Maia @MAIA_VERSION@ (Wayfire)": Maia na kompozytorze Wayfire.
#
# Uruchamiany przez SDDM: środowisko sesji, konfiguracja Wayfire tej wersji Maia, potem
# exec maia-session-service --compositor wayfire. Usługa sesji uruchamia Wayfire, czeka, aż jego
# [autostart] uruchomi $MAIA_SESSION_SCRIPT (pomocnik gotowości usługi), potem usługi i serwer Maia;
# gdy sesja się kończy, kończy Wayfire. Wspólne części obu sesji Maia: maia-session-common.sh.
#
# Konfiguracja Wayfire: ${MAIA_CONFIG_DIR}/wayfire.ini (~/.config/maia/<wersja>/wayfire.ini),
# całkowicie niezależna od ~/.config/wayfire.ini zwykłej sesji Wayfire. Przy pierwszym starcie
# kopiowana z szablonu <instalacja>/etc/maia/wayfire.ini (układ klawiatury brany z ustawień KDE,
# kxkbrc), potem należy do użytkownika.
# Wymagane pluginy Wayfire (spoza Maia, instalowane do katalogu pluginów Wayfire):
#   aurorae                  - dekoracje okien z motywów KDE Aurorae (wayfire-aurorae)
#   plasma-window-management - lista okien dla maia-windows-service (wayfire-plasma-window-management)

SCRIPT_PATH="$(readlink -f "$0")"
. "$(dirname "${SCRIPT_PATH}")/maia-session-common.sh"
SESSION_LOG="$HOME/maia_${MAIA_VERSION}_wayfire_session.log"
WAYFIRE_CONFIG="${MAIA_CONFIG_DIR}/wayfire.ini"
WAYFIRE_TEMPLATE="${MAIA_OPT_PATH}/etc/maia/wayfire.ini"

# Wartość klucza z pliku KConfig (np. LayoutList z grupy [Layout] w kxkbrc), "" gdy jej brak
kconfig_value() {
    local file="$1" group="$2" key="$3"
    [ -r "${file}" ] || return 0
    awk -v group="[${group}]" -v key="${key}" '
        /^\[/ { in_group = ($0 == group); next }
        in_group && index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }
    ' "${file}"
}

# Pierwszy start tej wersji Maia: kopia szablonu z układem klawiatury z ustawień KDE
create_wayfire_config() {
    if [ ! -r "${WAYFIRE_TEMPLATE}" ]; then
        echo "[ERROR] Brak szablonu konfiguracji Wayfire: ${WAYFIRE_TEMPLATE}"
        return 1
    fi
    local kxkbrc="${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc"
    local layout variant options
    layout="$(kconfig_value "${kxkbrc}" Layout LayoutList)"
    variant="$(kconfig_value "${kxkbrc}" Layout VariantList)"
    options="$(kconfig_value "${kxkbrc}" Layout Options)"
    echo "Tworzenie ${WAYFIRE_CONFIG} z ${WAYFIRE_TEMPLATE} (układ klawiatury: ${layout:-us})"
    # Wartości z kxkbrc w sed: tylko znaki, które mogą wystąpić w nazwach układów XKB
    sed -e "s|^xkb_layout *=.*|xkb_layout = ${layout:-us}|" \
        -e "s|^xkb_variant *=.*|xkb_variant = ${variant}|" \
        -e "s|^xkb_options *=.*|xkb_options = ${options}|" \
        "${WAYFIRE_TEMPLATE}" > "${WAYFIRE_CONFIG}.new" && mv "${WAYFIRE_CONFIG}.new" "${WAYFIRE_CONFIG}"
}

# Logujemy wszystko z sesji do katalogu domowego (jak w run_maia_kwin.sh)
: > "${SESSION_LOG}"
exec >> "${SESSION_LOG}" 2>&1
echo "--- START Maia ${MAIA_VERSION} (Wayfire) ---"

maia_session_prepare "${SCRIPT_PATH}"

if [ ! -e "${WAYFIRE_CONFIG}" ]; then
    create_wayfire_config || exit 1
fi
# [autostart] konfiguracji uruchamia pomocnika gotowości usługi sesji przez $MAIA_SESSION_SCRIPT
# (ustawia ją usługa; sh rozwija zmienną), więc w pliku użytkownika nie ma ścieżki instalacji. Bez tego
# wpisu usługa sesji nie doczeka się Wayfire i zakończy sesję.
if ! grep -q 'MAIA_SESSION_SCRIPT' "${WAYFIRE_CONFIG}"; then
    echo "[WARNING] ${WAYFIRE_CONFIG} nie uruchamia Maia ([autostart] bez \$MAIA_SESSION_SCRIPT);"
    echo "          przywróć wpis z ${WAYFIRE_TEMPLATE} albo usuń plik, żeby utworzyć go od nowa"
fi

maia_session_exec wayfire
