#!/bin/bash
# Sesja "Maia @MAIA_VERSION@ (KWin)": Maia na kompozytorze KWin.
#
# Uruchamiany przez SDDM: środowisko sesji, potem exec maia-session-service --compositor kwin.
# Usługa sesji uruchamia kwin_wayland_wrapper (restartuje KWina po awarii), usługi i serwer Maia,
# a gdy sesja się kończy, kończy KWina. Wspólne części obu sesji Maia: maia-session-common.sh.

SCRIPT_PATH="$(readlink -f "$0")"
. "$(dirname "${SCRIPT_PATH}")/maia-session-common.sh"
SESSION_LOG="$HOME/maia_${MAIA_VERSION}_kwin_session.log"

# Logujemy wszystko z sesji do katalogu domowego aktualnego użytkownika: usługę sesji, a przez nią
# kompozytor i wszystkie procesy sesji (każda linia z nazwą procesu na początku). Plik jest czyszczony,
# a potem otwarty do dopisywania: procesy sesji dziedziczą ten deskryptor.
: > "${SESSION_LOG}"
exec >> "${SESSION_LOG}" 2>&1
echo "--- START Maia ${MAIA_VERSION} (KWin) ---"

maia_session_prepare "${SCRIPT_PATH}"
maia_session_exec kwin
